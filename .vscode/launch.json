{
  "version": "0.2.0",
  "configurations": [
    // ── Backend: run the catalog dev server (FastAPI, #38) ──────────────────
    {
      "name": "FastAPI: catalog dev server",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["catalog.app:app", "--host", "0.0.0.0", "--port", "8006"],
      "cwd": "${workspaceFolder}/backend",
      "envFile": "${workspaceFolder}/.env",
      "python": "${workspaceFolder}/backend/.venv/bin/python3",
      "justMyCode": true
    },
    // ── Backend: pytest (all tests) ──────────────────────────────────────────
    {
      "name": "pytest: catalog",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["catalog", "--tb=short", "-ra"],
      "cwd": "${workspaceFolder}/backend",
      "envFile": "${workspaceFolder}/.env",
      "python": "${workspaceFolder}/backend/.venv/bin/python3",
      "justMyCode": false
    },
    // ── Backend: pytest (current file) ──────────────────────────────────────
    {
      "name": "pytest: current file",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["${file}", "--tb=short", "-ra"],
      "cwd": "${workspaceFolder}/backend",
      "envFile": "${workspaceFolder}/.env",
      "python": "${workspaceFolder}/backend/.venv/bin/python3",
      "justMyCode": false
    },
    // ── Frontend: Vitest (all tests) ─────────────────────────────────────────
    {
      "name": "Vitest: all",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "test:watch", "--", "--reporter=verbose"],
      "cwd": "${workspaceFolder}/frontend",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    },
    // ── Frontend: Vitest (current file) ─────────────────────────────────────
    {
      "name": "Vitest: current file",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "test:watch", "--", "${relativeFile}", "--reporter=verbose"],
      "cwd": "${workspaceFolder}/frontend",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    }
  ]
}
