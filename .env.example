# Single env file for the whole repo. Copy to `.env` in the repo root (`cp .env.example .env`).
# Read by Django (core/settings/base.py), Vite (envDir in frontend/vite.config.ts),
# docker-compose (env_file) and VS Code (.vscode/).
# Vite only exposes VITE_-prefixed vars to the browser bundle.

# --- Backend: Django ---
DJANGO_SETTINGS_MODULE=core.settings.dev
# 50+ random chars. PyJWT warns on HMAC keys under 32 bytes. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=your-secret-key-here
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
# docker-compose publishes Postgres on host port 5435 (5435:5432). Inside Docker
# Compose the service sets DATABASE_URL to @db:5432 itself.
# core/settings/dev.py falls back to localhost:5432 if this is unset.
DATABASE_URL=postgres://appuser:apppassword@localhost:5435/appdb

# Celery / Redis
# Host port is 6380 (docker-compose maps 6380:6379 to avoid clashing with a
# local Redis). Use redis://redis:6379/0 when running inside Docker Compose.
CELERY_BROKER_URL=redis://localhost:6380/0

# Cache (#11). db 1 of the same Redis on the dev stack (db 0 is the broker). Required
# under core.settings.prod; Docker Compose sets it to @redis:6379 itself.
CACHE_REDIS_URL=redis://localhost:6380/1
# false bypasses the cache without a code change. Default true.
# CACHE_ENABLED=true

# CORS: add the frontend origin
CORS_ALLOWED_ORIGINS=http://localhost:5174

# Email (override in prod)
DEFAULT_FROM_EMAIL=noreply@example.com

# Prometheus /metrics: peers (CIDRs) allowed to scrape it; everyone else gets 404.
# Defaults to loopback. On the LXC load-test deploy, set it to saas-monitor's address (/32).
# METRICS_ALLOWED_CIDRS=127.0.0.1/32,::1/128
# Set only under gunicorn with several workers (gunicorn.conf.py empties it on start).
# PROMETHEUS_MULTIPROC_DIR=/tmp/prometheus-multiproc

# Load tests (#9). DJANGO_SETTINGS_MODULE=core.settings.loadtest (or SETTINGS=loadtest)
# is prod over plain HTTP and refuses any public ALLOWED_HOSTS entry.
# Password for the loadtest-<n>@example.com owners that `seed_loadtest` creates.
# LOADTEST_OWNER_PASSWORD=
# Local load-test stack (infra/docker/docker-compose.loadtest.yml); all optional.
# GRAFANA_ADMIN_PASSWORD=admin  # Grafana on 127.0.0.1:3005
# LOADTEST_WORKERS=2            # gunicorn workers for the load-test backend
# LOADTEST_UID=1000             # uid k6 runs as, so loadtest/results/ files are yours

# Superuser (used by `just be-superuser`; email is the username field)
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=changeme

# --- Frontend: Vite ---
# URL of the Django API backend
VITE_API_BASE_URL=http://localhost:8005
