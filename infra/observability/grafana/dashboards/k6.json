        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(k6_dropped_iterations_total{testid=~\"$testid\"}[$__rate_interval])) or vector(0)",
          "legendFormat": "dropped/s",
          "refId": "A"
        }
      ],
      "title": "Dropped iterations",
      "type": "timeseries"
    }
  ],
  "refresh": "10s",
  "schemaVersion": 41,
  "tags": [
    "loadtest"
  ],
  "templating": {
    "list": [
      {
        "allValue": null,
        "current": {},
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "label_values(k6_http_reqs_total, testid)",
        "includeAll": false,
        "label": "testid",
        "multi": false,
        "name": "testid",
        "query": {
          "query": "label_values(k6_http_reqs_total, testid)",
          "refId": "testid"
        },
        "refresh": 2,
        "sort": 2,
        "type": "query"
      },
      {
        "allValue": ".*",
        "current": {},
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "label_values(k6_http_reqs_total{testid=~\"$testid\"}, name)",
        "includeAll": true,
        "label": "endpoint group",
        "multi": true,
        "name": "name",
        "query": {
          "query": "label_values(k6_http_reqs_total{testid=~\"$testid\"}, name)",
          "refId": "name"
        },
        "refresh": 2,
        "sort": 1,
        "type": "query"
      }
    ]
  },
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "title": "k6",
  "uid": "k6"
}
