# {{ ansible_managed }} (infra/ansible/roles/app). #13.
[Unit]
Description=SAAS_experimental catalog: retries type and user events to instances
After=network-online.target {{ app_unit }}.service
Wants=network-online.target

[Service]
User=app
Group=app
WorkingDirectory={{ app_dir }}
EnvironmentFile={{ app_env_file }}
RuntimeDirectory=saas-relay
# Its own metrics directory: gunicorn's on_starting hook empties the service's. Set in
# the command, since EnvironmentFile= overrides Environment= (#37).
ExecStart=/usr/bin/env PROMETHEUS_MULTIPROC_DIR=/run/saas-relay/prometheus {{ app_python }} {{ app_cmd.relay }}
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
