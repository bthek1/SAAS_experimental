# {{ ansible_managed }} (infra/ansible/roles/app). #9, Phase 4.
[Unit]
Description=SAAS_experimental {{ app_service }}: gunicorn, core.settings.loadtest (#9, #13)
After=network-online.target
Wants=network-online.target

[Service]
User=app
Group=app
WorkingDirectory={{ app_dir }}
EnvironmentFile={{ app_env_file }}
# /run/{{ app_unit }}/prometheus: gunicorn.conf.py empties it on start (multiprocess metrics).
RuntimeDirectory={{ app_unit }}
ExecStart={{ app_backend_dir }}/.venv/bin/gunicorn --bind 0.0.0.0:{{ ports.gunicorn }} --workers {{ gunicorn_workers }} --worker-class gthread --threads {{ gunicorn_threads }} core.wsgi
Restart=on-failure
KillMode=mixed
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
