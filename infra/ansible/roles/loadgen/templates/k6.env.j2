# {{ ansible_managed }} (infra/ansible/roles/loadgen). #9, Phase 4. Sourced by bash (loadtest/run.sh),
# so every value is single-quoted: p(95) is shell syntax unquoted.
BASE_URL='http://{{ guest_ips.gateway }}:{{ ports.gunicorn }}'
OWNERS='{{ hostvars[groups['app'][0]].loadtest_owners | default(5) }}'
LOADTEST_OWNER_PASSWORD='{{ loadtest_owner_password }}'
K6_PROMETHEUS_RW_SERVER_URL='http://{{ guest_ips.monitor }}:{{ ports.prometheus }}/api/v1/write'
# Native histograms give true per-minute latency. Trend stats are calculated since the run began.
K6_PROMETHEUS_RW_TREND_AS_NATIVE_HISTOGRAM='true'
K6_PROMETHEUS_RW_PUSH_INTERVAL='5s'
