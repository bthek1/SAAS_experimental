# {{ ansible_managed }} (infra/ansible/roles/monitor). #9, Phase 4.
# The LXC deploy's scrape config. k6 results arrive by remote write.
# `instance` is the container's name, so dashboards read saas-catalog, not an IP.
global:
  scrape_interval: 5s
  evaluation_interval: 15s

rule_files:
  - rules.yml

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets: ["localhost:{{ ports.prometheus }}"]
        labels: {instance: saas-monitor}

  # Each service directly: the gateway never routes /metrics. It answers this container
  # alone (METRICS_ALLOWED_CIDRS on each service).
  - job_name: django
    static_configs:
      - targets: ["{{ guest_ips.app }}:{{ ports.gunicorn }}"]
        labels: {instance: {{ groups.app[0] }}, service: catalog}
      - targets: ["{{ guest_ips.instances }}:{{ ports.gunicorn }}"]
        labels: {instance: saas-instances, service: instances}

  - job_name: postgres
    static_configs:
      - targets: ["{{ guest_ips.db }}:{{ ports.postgres_exporter }}"]
        labels: {instance: saas-db}

  - job_name: redis
    static_configs:
      - targets: ["{{ guest_ips.cache }}:{{ ports.redis_exporter }}"]
        labels: {instance: saas-cache}

  # instances on MongoDB (#30).
  - job_name: mongodb
    static_configs:
      - targets: ["{{ guest_ips.mongo }}:{{ ports.mongodb_exporter }}"]
        labels: {instance: saas-mongo}

  # node_exporter + the container's cgroup metrics (textfile collector).
  - job_name: node
    static_configs:
{% for role, ip in guest_ips.items() %}
      - targets: ["{{ ip }}:{{ ports.node_exporter }}"]
        labels: {instance: {{ groups[role][0] }}}
{% endfor %}
