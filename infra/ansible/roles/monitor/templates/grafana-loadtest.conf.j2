# {{ ansible_managed }} (infra/ansible/roles/monitor). #9, Phase 4. Holds a secret: 0600.
[Service]
Environment=GF_SECURITY_ADMIN_PASSWORD={{ grafana_admin_password }}
Environment=GF_AUTH_ANONYMOUS_ENABLED=false
Environment=GF_USERS_ALLOW_SIGN_UP=false
Environment=GF_DASHBOARDS_DEFAULT_HOME_DASHBOARD_PATH=/var/lib/grafana/dashboards/k6.json
# Read by provisioning/datasources/prometheus.yml.
Environment=PROMETHEUS_URL=http://localhost:{{ ports.prometheus }}
